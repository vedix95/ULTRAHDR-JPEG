<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="3"
    android:versionName="1.1.1">

    <!-- Permissions d'accès aux médias et photos de l'appareil -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- Fonctionnalités matérielles graphiques (OpenGLES 3 & Vulkan pour le rendu HDR) -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" />
    <uses-feature android:name="android.hardware.vulkan.version" android:required="false" />

    <!-- Support multi-formats exhaustif : smartphones, pliables (foldables), tablettes -->
    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true"
        android:anyDensity="true"
        android:resizeable="true" />

    <application
        android:label="UltraHDR Studio"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true">

        <activity
            android:name="com.ultrahdr.studio.MainActivity"
            android:label="UltraHDR Studio"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:exported="true">

            <!-- Bibliothèque native Rust compilée (libultrahdr.so) -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="ultrahdr" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Réception d'images partagées depuis une autre application (Galerie, Google Photos, etc.) -->
            <intent-filter android:label="UltraHDR Studio">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- Permet d'ouvrir directement une image depuis la galerie ou un explorateur -->
            <intent-filter android:label="UltraHDR Studio">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
